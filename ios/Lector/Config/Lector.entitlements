<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Gemeinsame Gruppe für den Zugangsschlüssel: App und Share Extension lesen denselben Eintrag. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)me.krinke.lector.shared</string>
	</array>
	<!-- Serveradresse in geteilten UserDefaults. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.me.krinke.lector</string>
	</array>
</dict>
</plist>
